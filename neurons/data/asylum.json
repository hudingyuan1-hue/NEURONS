  "dialogue": {
    "WRIST": [
      {
        "speaker": "护工[平静]",
        "text": "手伸出来，看一下号。",
        "source": "S3:P627"
      },
      {
        "speaker": "角色[疑惑]",
        "text": "床头不是写着吗？",
        "source": "S3:P628"
      },
      {
        "speaker": "护工[平静]",
        "text": "要对腕带。",
        "source": "S3:P629"
      }
    ],
    "WRIST_HURT": [
      {
        "speaker": "角色[疼痛]",
        "text": "你看号码，拧我手干什么？",
        "source": "S3:P631"
      },
      {
        "speaker": "护工[冷淡]",
        "text": "别动。",
        "source": "S3:P632"
      },
      {
        "speaker": "玩家[凝重]",
        "text": "他已经抓住了。",
        "source": "S3:P633"
      }
    ],
    "REGISTER_WITNESS": [
      {
        "speaker": "登记护士[平静]",
        "text": "这里写的是自行离院。",
        "source": "S3:P642"
      },
      {
        "speaker": "角色[质问]",
        "text": "他抓着门框不肯走，我看见了。",
        "source": "S3:P643"
      },
      {
        "speaker": "登记护士[平静]",
        "text": "我按记录答复。",
        "source": "S3:P644"
      }
    ],
    "REGISTER_RECORD": [
      {
        "speaker": "角色[疑惑]",
        "text": "这张上面，谁签的字？",
        "source": "S3:P646"
      },
      {
        "speaker": "登记护士[平静]",
        "text": "手续已经办过了。",
        "source": "S3:P647"
      }
    ],
    "REGISTER_FOLLOWUP": [
      {
        "speaker": "角色[坚持]",
        "text": "我问的是他去了哪。",
        "source": "S3:P649"
      },
      {
        "speaker": "角色看清记录后[生气]",
        "text": "你写的不是我问的。",
        "source": "S3:P651"
      },
      {
        "speaker": "玩家[凝重]",
        "text": "去向没写，追问倒记下了。",
        "source": "S3:P652"
      }
    ],
    "DOCTOR_CASE": [
      {
        "speaker": "角色[认真]",
        "text": "摘除记录和死亡记录，是同一个号。",
        "source": "S3:P668"
      },
      {
        "speaker": "医生[平静]",
        "text": "你认为它们有关系。",
        "source": "S3:P669"
      },
      {
        "speaker": "角色[生气]",
        "text": "不是我认为，纸上就这么写着。",
        "source": "S3:P670"
      }
    ],
    "DOCTOR_FALSE": [
      {
        "speaker": "角色[质问]",
        "text": "我没喝，他们写我喝了。",
        "source": "S3:P673"
      },
      {
        "speaker": "医生[平静]",
        "text": "你是在否认这份记录？",
        "source": "S3:P674"
      },
      {
        "speaker": "角色[生气]",
        "text": "我是在说它写错了。",
        "source": "S3:P675"
      }
    ],
    "DOCTOR_NONE": [
      {
        "speaker": "角色[疑惑]",
        "text": "我要去哪里才能出去？",
        "source": "S3:P677"
      },
      {
        "speaker": "医生[平静]",
        "text": "先说说你为什么想出去。",
        "source": "S3:P678"
      }
    ],
    "ASSIST_REACH": [
      {
        "speaker": "助手[平静]",
        "text": "手放这里。",
        "source": "S3:P690"
      },
      {
        "speaker": "角色[警惕]",
        "text": "你先说要做什么。",
        "source": "S3:P691"
      }
    ],
    "ASSIST_HOLD": [
      {
        "speaker": "角色[生气]",
        "text": "只是问话，为什么要扣住？",
        "source": "S3:P693"
      },
      {
        "speaker": "助手[平静]",
        "text": "先别动。",
        "source": "S3:P694"
      }
    ],
    "PHARMACY": [
      {
        "speaker": "治疗药师[平静]",
        "text": "把医嘱给我。",
        "source": "S3:P711"
      },
      {
        "speaker": "角色[疑惑]",
        "text": "上面写的是什么药？",
        "source": "S3:P712"
      },
      {
        "speaker": "治疗药师[平静]",
        "text": "按这张配。",
        "source": "S3:P713"
      }
    ],
    "REFUSE": [
      {
        "speaker": "角色[警惕]",
        "text": "我先不喝。",
        "source": "S3:P715"
      }
    ],
    "FALSE_MEDICINE": [
      {
        "speaker": "角色[生气]",
        "text": "杯子还满着。",
        "source": "S3:P721"
      },
      {
        "speaker": "给药护士[平静]",
        "text": "记录在这里签。",
        "source": "S3:P722"
      },
      {
        "speaker": "玩家[凝重]",
        "text": "她看见了，还是这样写。",
        "source": "S3:P723"
      }
    ],
    "DOCTOR_TRANSFER": [
      {
        "speaker": "角色[疑惑]",
        "text": "我要去哪里才能出去？",
        "source": "S3:P677"
      },
      {
        "speaker": "医生[平静]",
        "text": "先说说你为什么想出去。",
