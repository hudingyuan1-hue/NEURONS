  "dialogue": {
    "BACK_FACE":[{"speaker":"角色","text":"转过来了……还是没有脸。","source":"S3:P1071"}],
    "BACK_NUMBER":[{"speaker":"玩家","text":"前后都是同一个号。","source":"S3:P1072"}],
    "BACK_KNOWN":[{"speaker":"角色","text":"这个编号，我见过。","source":"S3:P1073"}],
    "TEAR_START":[{"speaker":"角色","text":"等一下，我还没看完。","source":"S3:P1088"}],
    "TEAR_KEEP":[{"speaker":"角色","text":"只留下这一角。","source":"S3:P1089"}],
    "TEAR_LOST":[{"speaker":"角色","text":"字没看清，纸先没了。","source":"S3:P1090"}],
    "TEAR_DIFF":[{"speaker":"玩家","text":"被改过的那一处，就在原件上。","source":"S3:P1091"}],
    "MASK":[{"speaker":"角色","text":"他一动，脸就被挡住了。","source":"S3:P1108"},{"speaker":"玩家","text":"被拖走的人还看得见。","source":"S3:P1109"}],
    "OVERLAY":[{"speaker":"角色","text":"刚才那张脸……像我。","source":"S3:P1110"},{"speaker":"玩家","text":"再看清楚。","source":"S3:P1111"}],
    "MIMIC":[{"speaker":"角色","text":"他在照着我做。","source":"S3:P1129"}],
    "MIMIC_WRITE":[{"speaker":"复述者","text":"自主行为。","source":"S3:P1128"}],
    "MIMIC_READ":[{"speaker":"角色","text":"连刚才那一下，也算我自己选的。","source":"S3:P1130"}],
    "CONSENT":[{"speaker":"角色","text":"拒绝，也被放进了‘已同意’。","source":"S3:P1137"}],
    "CLAMP_START":[{"speaker":"角色","text":"等一下，手还在里面。","source":"S3:P1150"}],
    "CLAMP_MISS":[{"speaker":"角色","text":"差一点。","source":"S3:P1151"}],
    "CLAMP_HURT":[{"speaker":"角色","text":"手都夹伤了。","source":"S3:P1152"}],
    "CLAMP_RECORD":[{"speaker":"角色","text":"它还写着‘无异常’。","source":"S3:P1153"},{"speaker":"玩家","text":"灯亮着，记录却没变。","source":"S3:P1154"}]
  }
