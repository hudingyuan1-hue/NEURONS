  "observations": [
    {
      "id": "hippocampus_records",
      "room": "hippocampus",
      "props": [
        "记忆陈列",
        "档案柜"
      ],
      "source": "S3:P1528–1533",
      "description": "衣物保留领标、缝线与伤痕，原始与修订记录分别陈列；具体编号、时间未核，不认定这些伤痕均为角色亲历。",
      "line": "痕迹还在，记录却改了。"
    },
    {
      "id": "thalamus_records",
      "room": "thalamus",
      "props": [
        "控制台",
        "监测屏"
      ],
      "source": "S3:P1535–1539",
      "description": "查看编号关联与不同科室的记录结构，原始与修订来源分开；具体编号字形尚未核实，不认定人物同一。",
      "line": ""
    },
    {
      "id": "cerebellum_records",
      "room": "cerebellum",
      "props": [
        "控制终端"
      ],
      "source": "S3:P1541–1545",
      "description": "训练记录有完成次数字段，伤情栏缺失；具体次数未核。姿态架不是角色曾受约束的证明。",
      "line": "做了多少次，记得很清楚。伤在哪儿，没有这一栏。"
    },
    {
      "id": "hypothalamus_records",
      "room": "hypothalamus",
      "props": [
        "监测屏"
      ],
      "source": "S3:P1547–1552",
      "description": "监测记录保留身体数据字段，缺本人意见；监护编号字形未知，不补写断食、断水经历。",
      "line": "身体的数值都在，我说过什么呢？"
    },
    {
      "id": "basal_records",
      "room": "basal",
      "props": [
        "路径终端"
      ],
      "source": "S3:P1554–1558",
      "description": "原始选择分别写同意、拒绝，最终均归为同意；两份记录的编号与时间仍未知，不拼接成角色同一次决定。",
      "records": [
        {
          "record": "A",
          "original_choice": "同意",
          "final_stamp": "同意",
          "identity": null,
          "time": null
        },
        {
          "record": "B",
          "original_choice": "拒绝",
          "final_stamp": "同意",
          "identity": null,
          "time": null
        }
      ],
      "line": "写了‘拒绝’，最后还是‘同意’。"
    },
    {
      "id": "amygdala_records",
      "room": "amygdala",
      "props": [
        "监测屏",
        "情绪记录台"
      ],
      "source": "S3:P1560–1565",
      "description": "警戒和安抚区域均记录行为，却缺本人陈述栏；灯和座椅不治疗，也不使敌人失去目标。",
      "line": "换了一间房，还是没有让我说话的地方。"
    },
    {
      "id": "brainstem_records",
      "room": "brainstem",
      "props": [
        "生命监测终端",
        "维生控制台"
      ],
      "source": "S3:P1567–1574",
      "description": "生命体征记录与伤情缺项并存；记录不清除真实伤害，不复活已死亡人物，具体监护编号未核。",
      "line": "还活着，就可以不写受过什么伤？"
    }
  ]
