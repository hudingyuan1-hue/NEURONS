    "PATIENT_NUMBER":[{"speaker":"人物[认真]","text":"名字他们会换。看后面的数。","source":"S3:P762/P443"},{"speaker":"角色[疑惑]","text":"你说哪个？","source":"S3:P444"},{"speaker":"人物[认真]","text":"翻过来。","source":"S3:P445"},{"speaker":"玩家[认真]","text":"他说的是背面。","source":"S3:P446"}],
