 a=setup_bag();bag_step(.8);app.street._actor("transporter_hospital",.025);hit_count=count_fact("combat_hit");var snapshot:Dictionary=app.snapshot_data();snapshot.street_state.erase("laundry_bag")
 check(app.restore_snapshot(JSON.parse_string(JSON.stringify(snapshot))),"legacy Street JSON without the new bag state remains loadable")
