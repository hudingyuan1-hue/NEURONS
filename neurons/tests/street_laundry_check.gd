extends "res://tests/street_materials_check.gd"
## Finite cast/alignment fixtures, actual shared attack/damage/pause/JSON handlers.
func setup_bag(phase:String="windup") -> Dictionary:
 no_street();app.street.data.erase("laundry_bag");app.layout.furniture.clear();app.layout.rebuild_grid()
 app.rules.hp=100;app.rules.sp=100;app.rules.hurt_left=0;app.rules.stun_left=0;app.rules.reaction_left=0;app.rules.reaction_skill="";app.rules.end_control()
 app.rules.settled.clear();app.rules.action.clear();app.rules.pending_neural.clear();app.rules.pending_skin.clear();app.street.data.next_attack=0
 app.hero_pos=Vector2(4.96,4);app.hero_route=PackedVector2Array()
 var a:Dictionary=actor_at("transporter_hospital",Vector2(4,4));a.hp=60;a.phase=phase;a.direction=[1,0];a.elapsed=0.0;a.cooldown=0.0;a.hits={};a.last_seen=[];a.attack_id="declared_laundry:"+str(passes.size())
 app.street.laundry_bag.sync();return a
func bag_step(seconds:float) -> void:
 for i in range(ceili(seconds/.025)):app.street._actor("transporter_hospital",.025)
func disk_roundtrip() -> bool:
 if not app.store.save_snapshot(app.snapshot_data()).ok:return false
 var loaded:Dictionary=app.store.load_snapshot()
 return loaded.ok and app.restore_snapshot(loaded.data)
