 file.store_string(JSON.stringify({"passes":passes,"failures":failures,"scope":"Explicit aligned/flank/four-direction/cabinet/neutral/parent poses with actual paid CONTROL and legal kick, real shared15HP/GUT/once-per-victim/recovery, real JSON/manual pause/old pose and actual production fountain. Trial attached glass/arm geometry, not final art or natural full-game/crowd acceptance."},"  "));file.close()
