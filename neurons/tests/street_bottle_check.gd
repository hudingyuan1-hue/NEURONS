 embrace_scene(offset);app.street.data.actors.isolation.present=false;app.street.data.erase("father_bottle")
 var a:Dictionary=actor_at("father",Vector2(4,4));a.hp=80;a.direction=app.street.xy(heading);a.phase="windup";a.elapsed=0;a.cooldown=0;a.hits={};a.attack_id="declared_bottle:"+str(passes.size()+failures.size());app.street.bottle.sync();return a
