 a=bottle_scene();app.street.layouts.erase("street_plaza");app.room_id="";app.enter_room("street_plaza");a.pos=[5.85,5.5];a.direction=[1,0];app.hero_pos=Vector2(10,5.5);app.street.bottle.sync();step(1.15)
 print("BOTTLE_FOUNTAIN ",JSON.stringify({"father":a,"profile":app.street.bottle.state()}));print("FOUNTAIN_RECT ",app.layout.furniture)
 check(app.street.bottle.state().blocked and app.rules.hp==100,"original production fountain stops bottle/arm movement without deleting its geometry")
