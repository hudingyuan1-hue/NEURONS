extends "res://tests/street_materials_check.gd"
## Explicit cast/position/clear-floor fixtures; production perception and state handlers.
func _ready() -> void:
 name="CampaignCheck";frontend=get_parent();folder="res://../docs/validation/street_displays_20261018/finite"
 for argument in OS.get_cmdline_user_args():
  if argument.begins_with("--validation-root="):folder=argument.trim_prefix("--validation-root=")
 DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(folder))
 await frames();await frontend.show_profile();frontend.name_field.text="Street展示与目击验证";frontend.overwrite_armed=true;frontend.new_game();await frames();app=frontend.active
 if app.tutorial_ui!=null:app.tutorial_ui.finish()
 app.set_process(false);clear_lines();app.paused_manual=true;app.home.enabled=false;app.family.enabled=false;app.unlock_combat();no_actors();app.unlock_street();no_street()
 var display=app.street.displays
 var legacy:Dictionary=app.street.data.duplicate(true);legacy.erase("displays");app.street.data=legacy;display.normalize()
 check(app.street.data.displays.actors.size()==8,"old Street snapshot lazily gains eight independent display states without replacing original actors")
 app.enter_room("street_plaza");no_street();app.layout.furniture.clear();app.layout.rebuild_grid();app.hero_pos=Vector2(6,5)
 actor_at("register_nurse",Vector2(7,5));var hp:int=app.rules.hp;var sp:int=app.rules.sp;var ownership:Dictionary=app.rules.owners.duplicate(true)
 advance_actor("register_nurse",.8)
 check(not display.state("register_nurse").read_seen,"brief glimpse of raised number sheet does not auto-complete reading")
 advance_actor("register_nurse",.6)
 check(known_id("street_register_sheet") and display.state("register_nurse").read_seen,"actual exposed paper and close clear sustained sight produce the limited observation")
 check(not known_id("street_register_mismatch") and app.street.config.displays.register_sheet_number==null,"unknown glyph cannot assert a wristband mismatch")
 check(app.rules.hp==hp and app.rules.sp==sp and app.rules.owners==ownership,"stamping does not register, charge or transfer anything")
 no_street();var back:Dictionary=actor_at("back",Vector2(7,5))
 advance_actor("back",.65)
 check(display.state("back").front and not display.state("back").back,"front view is observed separately, not granted together with reverse")
 advance_actor("back",.5)
 check(not display.state("back").back and back.phase=="number_turn","turning does not grant an unread reverse")
 advance_actor("back",.8);var turned:float=display.state("back").elapsed
 check(display.state("back").front and display.state("back").back,"same actual person completes both separately exposed views")
 advance_actor("back",3)
 check(is_equal_approx(display.state("back").elapsed,turned) and back.phase=="number_back","remaining nearby cannot spin the person indefinitely")
 display.tick();check(not app.dialogue_queue.is_empty() and app.dialogue_queue[0].text=="转过来，还是没有脸。","original line follows actual complete two-sided viewing")
 clear_lines();await capture("01_back_and_sheet")

 app.enter_room("street_side");no_street();app.layout.furniture.clear();app.layout.rebuild_grid();app.hero_pos=Vector2(6,4)
 var postop:Dictionary=actor_at("postop",Vector2(7,4));advance_actor("postop",.55)
 check(postop.phase=="dressing_show" and not known_id("street_postop_cancelled"),"partial dressing exposure does not award full evidence")
 postop.hurt=.2;advance_actor("postop",.4)
 check(not known_id("street_postop_cancelled") and postop.phase=="display_retreat","actual hurt covers the wound and discards partial reading")
 advance_actor("postop",2);check(not known_id("street_postop_cancelled"),"hurt display does not silently finish or force replay while staying near")
 app.hero_pos=Vector2(11,4);advance_actor("postop",.05);app.hero_pos=Vector2(6,4);advance_actor("postop",1.0)
 check(known_id("street_postop_cancelled") and postop.hp>0,"voluntary fresh approach can actually read cancellation on a living patient")
 check(app.rules.hp==hp and app.rules.sp==sp,"exposing a dressing cannot expand an old wound or drain the host")
 await capture("02_dressing_read")
 var threat:Dictionary=actor_at("self",Vector2(8,4));threat.hostile=true;advance_actor("postop",.1)
 check(postop.phase=="dressing_cover" and known_id("street_postop_cancelled"),"visible danger closes exposure without deleting earlier knowledge")
 threat.present=false;no_street();app.hero_pos=Vector2(5,4)
 var chair:Dictionary=actor_at("wheelchair",Vector2(6,4));threat=actor_at("self",Vector2(7,4));threat.hostile=true
 var before:Vector2=app.street.position("wheelchair");advance_actor("wheelchair",.2)
 check(chair.phase=="protect_photo" and known_id("street_photo_protected"),"actually seen danger causes a witnessed protective photograph gesture")
 check(app.street.position("wheelchair").distance_to(before)<=.171,"whole wheelchair retreats continuously, without a wall-side teleport")
 check(app.rules.owners==ownership,"visible photograph gesture creates no duplicate or reclaimed original")
 check(display.blocks(app.room_id,app.street.position("wheelchair")+Vector2(.55,0),.21),"physical wheelchair footprint extends beyond the actor body")
 var rect:Rect2=display.chair_rect(app.street.position("wheelchair"));app.layout.furniture.append({"id":"fixture_wall","name":"明确测试隔墙","height":80,"rect":Rect2(Vector2(8.3,3),Vector2(.2,3))});app.layout.rebuild_grid()
 check(not display._chair_clear(Vector2(8,4)),"complete chair width rejects a narrow wall-side clearance")
 chair.hp=0
 check(display.blocks(app.room_id,rect.get_center(),.21),"patient death leaves the same physical wheelchair in place")
 no_street();app.hero_pos=Vector2(5,4);actor_at("transport_patient",Vector2(6,4));advance_actor("transport_patient",.7)
 check(known_id("street_patient_band") and not known_id("street_transport_identity_matched"),"living patient can show own band but unknown number cannot identify a former bed occupant")
 await capture("03_band_and_chair")

 app.enter_room("street_twisted");no_street()
 var portal:Dictionary=app.layout.portal("street_maintenance");var guide_at:Vector2=Vector2(portal.at)+Vector2(portal.inward)*2
 actor_at("triage",guide_at);app.hero_pos=guide_at+Vector2(0,-1)
 advance_actor("triage",1.7)
 check(not display.state("triage").read_seen,"closed or briefly opened number clip does not provide full transfer records")
 advance_actor("triage",.65)
 check(display.state("triage").read_seen and known_id("street_guide_clip"),"visible existing branch and open clip produce only actually read batch-field information")
 check(app.StreetMap.doors("street_maintenance")==["street_twisted"],"guide does not create a rear shortcut from maintenance")
 await capture("04_real_branch_clip")

 app.enter_room("street_node");no_street();app.layout.furniture.clear();app.layout.rebuild_grid();app.hero_pos=Vector2(7,5);app.hero_state="idle"
 var blind:Dictionary=actor_at("blind",Vector2(8,5));advance_actor("blind",12)
 check(blind.phase=="idle","stationary hero cannot trigger a clock-driven black cloth")
 app.hero_state="walk";app.hero_pos=Vector2(7.03,5);advance_actor("blind",.35)
 check(blind.phase=="cloth","real nearby displacement with walking pose starts a finite cloth lift")
 check(not app.street.can_see(app.room_id,Vector2(8,4.8),Vector2(8,6.5)) and not app.street.can_see(app.room_id,Vector2(8,6.5),Vector2(8,4.8)),"actual local black-cloth footprint blocks sight in both directions")
 check(app.street.can_see(app.room_id,Vector2(10,4.8),Vector2(10,6.5)),"cloth leaves a real visible route around its local width")
 var blind_at:Vector2=app.street.position("blind");app.hero_pos=blind_at+Vector2(-.5,0);advance_actor("blind",.1)
 check(app.street.position("blind").distance_to(blind_at)<.001,"active cloth remains at its real stopped position instead of yielding through the host")
 app.hero_pos=Vector2(7.03,5)
 var elapsed:float=display.state("blind").elapsed;app._process(.5)
 check(is_equal_approx(display.state("blind").elapsed,elapsed),"manual pause freezes finite cloth hold")
 for i in range(100):app.hero_pos.x+=.001;app.street._actor("blind",.025)
 check(blind.phase=="idle" and display.state("blind").cooldown>0,"continuous footsteps cannot reset an already active hold indefinitely")
 blind.phase="cloth";blind.present=false
 check(app.street.can_see(app.room_id,Vector2(8,4.8),Vector2(8,6.5)),"absent actor cannot leave an invisible cloth occluder")

 app.enter_room("street_end");no_street();app.layout.furniture.clear();app.layout.rebuild_grid();app.hero_pos=Vector2(6,5);app.hero_state="idle";app.hero_facing=Vector2.RIGHT
 var mimic:Dictionary=actor_at("mimic",Vector2(7.5,5));advance_actor("mimic",.025)
 var records:int=app.rules.institutional_records.size();var neurons:int=app.rules.neurons;var evidence:int=app.rules.evidence.size();var at:Vector2=app.street.position("mimic")
 app.hero_facing=Vector2.UP;advance_actor("mimic",.2)
 check(mimic.phase=="mimic" and display.state("mimic").action.kind=="turn","clear actual turn supplies a single observed action")
 check(app.rules.institutional_records.size()==records,"copying alone does not prewrite an institutional claim")
 app.hero_pos=at+Vector2(-.5,0);advance_actor("mimic",.025)
 check(app.street.position("mimic").distance_to(at)<.001,"copy stays in place even when normal passive yielding would otherwise move the figure")
 app.hero_pos=Vector2(6,5)
 advance_actor("mimic",.6)
 check(mimic.phase=="mimic_write" and app.rules.institutional_records.size()==records,"incomplete writing still cannot grant a complete record")
 var snapshot:Dictionary=JSON.parse_string(JSON.stringify(app.snapshot_data()));check(app.restore_snapshot(snapshot),"partial display and writing snapshot restores through the real save path")
 app.set_process(false);app.paused_manual=true;clear_lines();display=app.street.displays;mimic=app.street.data.actors.mimic
 advance_actor("mimic",.7)
 check(app.rules.institutional_records.size()==records+1 and app.rules.institutional_records.back().text=="自主行为","only completing restored remaining writing creates the institutional label")
 advance_actor("mimic",2)
 check(app.rules.institutional_records.size()==records+1,"same stationary observation cannot repeat or queue a record")
 check(app.street.position("mimic").distance_to(at)<.001 and app.rules.hp==hp and app.rules.neurons==neurons and app.rules.evidence.size()==evidence,"local copy cannot move, damage, reward or create fourth-wall evidence")
 app.hero_facing=Vector2.LEFT;advance_actor("mimic",.2);mimic.hurt=.2;advance_actor("mimic",.5);advance_actor("mimic",2)
 check(app.rules.institutional_records.size()==records+1 and display.state("mimic").action.is_empty(),"hurt discards the interrupted observation without queued replay")
 app.layout.furniture.append({"rect":Rect2(6.6,3,.2,4)});app.layout.rebuild_grid();app.hero_facing=Vector2.DOWN;advance_actor("mimic",2)
 check(app.rules.institutional_records.size()==records+1,"a wall prevents copying an unseen turn")
 app.layout.furniture.clear();app.layout.rebuild_grid();advance_actor("mimic",.025);display.tick()
 check(not app.dialogue_queue.is_empty() and app.dialogue_queue[0].text=="它在学我。","original recognition line requires actually seeing the corresponding local copy")
 clear_lines();await capture("05_mimic_written")

 no_street();app.hero_pos=Vector2(6,5);app.hero_state="idle"
 var informant:Dictionary=actor_at("informant",Vector2(7,5));var receiver:Dictionary=actor_at("guard_hospital",Vector2(8,5));receiver.hostile=true;receiver.present=false
 advance_actor("informant",1.3)
 check(informant.report_target.is_empty() and not receiver.has("investigation"),"absent hostile receiver cannot be informed or used as a phantom signal target")
 receiver.present=true;receiver.hostile=false;advance_actor("informant",1.3)
 check(informant.report_target.is_empty(),"neutral receiver cannot be converted into an enemy by a report")
 receiver.hostile=true;receiver.phase="windup";receiver.elapsed=.3;receiver.attack_id="declared:already-launched";receiver.hits={"hero":true}
 advance_actor("informant",.3);var reported:Array=informant.report_target.duplicate()
 app.hero_pos=Vector2(6,5.3);advance_actor("informant",.75)
 check(receiver.investigation.at==reported and app.street.vector(receiver.investigation.at).distance_to(app.hero_pos)>.2,"real recipient receives the last reported position rather than a new remote hero location")
 check(receiver.phase=="windup" and is_equal_approx(receiver.elapsed,.3) and receiver.hits.has("hero"),"receiving a report cannot reset a launched attack or its hit receipt")
 check(known_id("street_informant_point") and app.street.data.reports.informant.witnessed,"only complete actually witnessed signaling grants the original limited observation")
 receiver.present=false;display.tick()
 check(not app.dialogue_queue.is_empty() and app.dialogue_queue[0].text=="在给他们指路。","witnessed report line waits for the real safe gap")
 clear_lines();receiver.present=true;informant.report_left=0;advance_actor("informant",.3);informant.hurt=.2;advance_actor("informant",.1)
 check(informant.report_target.is_empty() and informant.phase=="idle" and informant.report_serial==1,"hurt cancels incomplete reporting and visible pointing without replay or delivery")
 informant.report_left=0;receiver.present=false;var head:Dictionary=actor_at("head_nurse",Vector2(7,6));advance_actor("head_nurse",1.2)
 check(head.report_target.is_empty(),"head nurse does not report to an absent medical actor")
 receiver.present=true;receiver.room="street_node";advance_actor("head_nurse",1.2)
 check(head.report_target.is_empty(),"report cannot inform actors in another room")
 receiver.room=app.room_id;var second_receiver:Dictionary=actor_at("doctor",Vector2(7,7));second_receiver.hostile=true
 var point_origin:Vector2=app.street.position("head_nurse")
 advance_actor("head_nurse",1.1)
 check(app.street.data.reports.head_nurse.receivers.size()==2 and receiver.investigation.at==app.street.data.reports.head_nurse.at and second_receiver.investigation.at==receiver.investigation.at,"head nurse can notify both actual existing medical witnesses of the same old position")
 check(app.street.vector(head.direction).dot((app.street.vector(app.street.data.reports.head_nurse.at)-point_origin).normalized())>.999,"head nurse points from the actual signal origin toward the reported host position before later side adjustment")
 await capture("06a_informant_old_position")

 no_street();app.hero_pos=Vector2(6,5);app.hero_state="idle";actor_at("double_face",Vector2(7,5));var reaction=app.street.reactions
 app.rules.effects.TINNITUS=1.0;reaction.on_skill({"id":"TINNITUS","event_id":"display:internal_only","success":true});reaction.tick(.1)
 check(not app.street.data.visible_casts.has("display:internal_only"),"internal tinnitus effect alone does not count as an externally seen body reaction")
 app.street._hero(.025);reaction.tick(.5)
 check(app.hero_state=="tinnitus" and app.street.data.visible_casts.has("display:internal_only"),"actual stopped head/ear pose gives double-face a visible reaction")
 await capture("06_visible_tinnitus_pose")
 var file:=FileAccess.open(ProjectSettings.globalize_path(folder).path_join("result.json"),FileAccess.WRITE)
 file.store_string(JSON.stringify({"passes":passes,"failures":failures,"rendered":DisplayServer.get_name()!="headless","scope":"Eight positioned passive actor fixtures; selected clear floors/wall obstruction, actual production perception/exposure/motion, hurt, manual pause and JSON restore. Unknown glyph matches remain unavailable. Not natural all-cast/full-game/human art or audio acceptance."},"  "));file.close()
 print("STREET_DISPLAYS_CHECK %d passed %d failed"%[passes.size(),failures.size()]);app.audio.reset_scene();frontend.request_exit(0 if failures.is_empty() else 1)
