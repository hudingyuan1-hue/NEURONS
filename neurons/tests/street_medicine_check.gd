 check(not app.rules.gripped and app.room_id=="street_twisted" and app.rules.sp==80,"invalid remote head holder releases locally and cannot transport the host")
 a=medicine_scene(Vector2(.9,.45));step(1.15)
 check(not app.rules.gripped and app.rules.sp==80 and a.phase=="recover","hand passing beside head cannot acquire the whole forward body rectangle")
 a=medicine_scene();app.layout.furniture.append({"id":"declared_head_cabinet","name":"明确挡手柜","rect":Rect2(4.45,3.7,.15,.6),"height":120});app.layout.rebuild_grid();step(1.15)
 check(not app.rules.gripped and app.rules.sp==80 and app.street.medicine.state().blocked,"real cabinet blocks the reaching hand before any head hold or dose")
 check(app.street.vector(app.street.medicine.state().cup).distance_to(Vector2(4.15,4))<.01,"blocked head reach retracts the still-full cup from its actual palm, not from an unvisited mouth behind the cabinet")
 a=medicine_scene();app.rules.reaction_skill="WITHDRAW";app.rules.reaction_left=3;step(2.2)
 check(app.rules.sp==60 and not app.rules.gripped,"WITHDRAW never frees established head fixation or cancels its actual swallow")
