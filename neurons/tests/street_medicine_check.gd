 check(app.street.medicine.state().dose=="pouring" and a.portions==0 and app.rules.sp==80,"one actual poured dose leaves the cup before swallowing, with no premature spirit loss")
 var time:float=app.street.data.clock
 check(disk() and app.street.medicine.state().dose=="pouring" and app.street.data.actors.ward_nurse.portions==0,"real pouring JSON preserves the one dose outside the cup instead of refilling it")
