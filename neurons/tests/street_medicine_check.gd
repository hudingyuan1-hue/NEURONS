extends "res://tests/street_embrace_check.gd"
## Explicit cast/dose/contact fixtures; real shared hold and actual liquid stages.
func medicine_scene(offset:Vector2=Vector2(.9,0)) -> Dictionary:
 embrace_scene(offset);app.street.data.actors.isolation.present=false;app.street.data.erase("ward_medicine")
 var a:Dictionary=actor_at("ward_nurse",Vector2(4,4));a.hp=60;a.portions=1;a.direction=[1,0];a.phase="windup";a.elapsed=0;a.cooldown=0;a.hits={};a.attack_id="declared_medicine:"+str(passes.size());app.street.medicine.sync();return a
