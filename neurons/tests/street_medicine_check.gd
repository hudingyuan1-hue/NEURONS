 file.store_string(JSON.stringify({"passes":passes,"failures":failures,"scope":"Declared one nurse/host/cup fixtures; actual hand contact, real cup approach/pour/swallow/SP-only settled effect and independent interruption, actual paid CONTROL and DRYMOUTH, JSON/manual pause/legacy/head misses/blocker/other owner/empty cup. Timings within original1.2s; no new story, silence skill, natural crowd or formal art acceptance."},"  "));file.close()
