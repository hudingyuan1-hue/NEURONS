 a=app.street.data.actors.ward_nurse;step(2)
 check(app.rules.sp==60 and a.portions==0 and count_fact("street_medicine_swallowed")==before_swallow+1,"post-dose save/recovery cannot repay medicine or refill an empty palm cup")
 app.enter_room("street_maintenance");app.enter_room("street_twisted")
 check(app.street.data.actors.ward_nurse.portions==0,"ordinary room return does not refill the same nurse's exhausted cup")
 a=medicine_scene();step(1.3);app.street.damage_actor("father","ward_nurse",15,"declared_before_pour_hurt")
 check(not app.rules.gripped and app.rules.sp==80 and a.portions==1,"actual interruption before pouring withdraws the full cup and causes no oral medicine effect")
 a=medicine_scene();step(1.95);app.street.damage_actor("father","ward_nurse",15,"declared_after_pour_hurt")
 check(not app.rules.gripped and app.rules.sp==80 and a.portions==0 and app.street.medicine.state().dose=="spilled","actual interruption after pouring but before swallowing spills that consumed dose without applying or refunding effects")
 step(2)
 check(app.rules.sp==80 and a.portions==0,"spilled dose cannot later finish itself or create a replacement serving")
 a=medicine_scene();step(1.3);app.street.damage_actor("father","ward_nurse",100,"declared_nurse_death")
 check(a.hp==0 and not app.rules.gripped and app.rules.sp==80,"actual nurse death immediately withdraws the established head hold without swallowing")
 a=medicine_scene();step(1.3);a.present=false;app.street._actor("ward_nurse",.025)
 check(not app.rules.gripped and app.street.data.holder=="" and app.rules.sp==80,"absent owner releases even though ordinary absent actors stop ticking")
