 await frames();await frontend.show_profile();frontend.name_field.text="给药独立接触吞咽验证";frontend.overwrite_armed=true;frontend.new_game();await frames();app=frontend.active
 if app.tutorial_ui!=null:app.tutorial_ui.finish()
