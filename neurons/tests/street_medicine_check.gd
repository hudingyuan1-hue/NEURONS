 check(a.phase=="drug_hold" and app.street.data.holder=="ward_nurse" and app.rules.sp==80 and app.rules.hp==100 and a.portions==1,"actual hand-to-head contact creates only a head hold, no oral medicine or life damage")
 var before_swallow:int=count_fact("street_medicine_swallowed");step(.55)
