 app.rules.skill_states.CONTROL.until=0;app.rules.submit_skill("CONTROL",{});app.rules.apply_pending();step(2.2)
 print("MEDICINE_DRYMOUTH ",JSON.stringify({"result":result,"active_at_cast":active,"sp":app.rules.sp,"actor":a,"pose":app.street.medicine.state()}))
 check(result.ok and result.success and active and app.rules.sp==60,"actual paid combat DRYMOUTH suppresses voice per S2:T12R7, not swallowing or the original medicine outcome")
 # Reachable legacy grip; missing trajectory stays static within original1.2s.
 a=medicine_scene();app.street.data.erase("grasp_motion");var guard:Dictionary=actor_at("guard_hospital",app.hero_pos+Vector2(0,1.05));guard.phase="grip";app.street.data.holder="guard_hospital";app.street.data.grip_until=app.street.data.clock+1.2;app.rules.gripped=true;step(1.15)
 check(app.street.data.holder=="guard_hospital" and app.rules.sp==80 and a.portions==1,"prepared hand cannot steal another owner or queue a medicine dose behind them")
 app.street.damage_actor("father","ward_nurse",15,"declared_non_owner_nurse_hurt")
 check(app.street.data.holder=="guard_hospital" and app.rules.gripped,"hurting a non-owner nurse cannot release a different physical holder")
 a=medicine_scene();step(1.3);var saved:Dictionary=app.snapshot_data();saved.street_state.erase("ward_medicine")
 check(app.restore_snapshot(JSON.parse_string(JSON.stringify(saved))) and app.street.data.holder=="ward_nurse","legacy existing head-hold save reconstructs current cup pose without invented past swallowing")
 step(1)
 check(app.rules.sp==60 and app.street.medicine.state().dose=="swallowed","legacy full cup completes its one actual remaining sequence without duplicate effect")
 a=medicine_scene();a.phase="idle";app.hero_pos=Vector2(5.6,4);step(3)
 print("MEDICINE_APPROACH ",JSON.stringify({"sp":app.rules.sp,"actor":a,"holder":app.street.data.holder,"pose":app.street.medicine.state()}))
 check(app.rules.sp==60 and a.portions==0 and app.street.medicine.state().dose=="swallowed","ordinary autonomous approach reaches actual head and mouth contact then completes its real single dose")
 a=medicine_scene();a.portions=0;a.phase="idle";step(3)
 check(not app.rules.gripped and app.rules.sp==80 and a.phase=="idle","an already empty cup cannot start a new head capture merely by approaching")
 a=medicine_scene();step(1.1);a.portions=0;app.street.data.erase("ward_medicine");step(1.25)
 check(not app.rules.gripped and app.rules.sp==80 and a.phase=="recover","legacy held-head state without a remaining dose cannot invent swallowing or exceed original1.2s release deadline")
 a=medicine_scene();app.rules.sp=10;step(2.2)
 check(app.rules.sp==0 and app.rules.hp==100 and not app.rules.gripped,"original medicine clamps low spirit to zero without converting mental loss into invented HP death")
